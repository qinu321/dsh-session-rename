{
  "name": "dsh-session-rename",
  "version": "1.0.0",
  "description": "Lets an AI rename its own session in DeepSeek Harness — a zero-dependency plugin that adds the session_rename tool.",
  "author": "qinu321 (https://github.com/qinu321)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinu321/dsh-session-rename.git"
  },
  "homepage": "https://github.com/qinu321/dsh-session-rename#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
