{
  "name": "dsh-session-rename",
  "version": "1.0.0",
  "private": true,
  "description": "Adds a session_rename tool so an Agent can title its own Session. | 让 AI 重命名自己会话的插件。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
